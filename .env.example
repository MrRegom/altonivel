# Copia este archivo a .env y ajusta los valores. NO subas .env al repo.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Correo (si se omite EMAIL_HOST, los correos se imprimen en consola) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=clave-de-aplicacion
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=facturacion@tudominio.cl

# --- Emisión de DTE ---
# consola = simulado para desarrollo; openfactura = proveedor real; sii_directo = a futuro
EMISOR_BACKEND=consola

# Enviar el DTE por correo al cliente automáticamente cuando el SII lo acepta.
ENVIAR_DTE_AL_ACEPTAR=True

# --- OpenFactura (solo si EMISOR_BACKEND=openfactura) ---
# Desarrollo: https://dev-api.haulmer.com, con la API key PÚBLICA de prueba
# 928e15a2d14d4a6292345f04960f4bd3 (empresa demo; ejecutar
# "python manage.py cargar_emisor_demo"). Folios simulados, sin validez.
# Producción: https://api.haulmer.com con la API key de la empresa real.
OPENFACTURA_API_KEY=
OPENFACTURA_BASE_URL=https://dev-api.haulmer.com
OPENFACTURA_TIMEOUT=30
