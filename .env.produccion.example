DJANGO_DEBUG=False
# IP o dominio por el que se entra a la app
DJANGO_ALLOWED_HOSTS=157.245.131.99
DJANGO_CSRF_TRUSTED_ORIGINS=http://157.245.131.99:8090
# Poner True solo si se accede por https (detrás de Caddy/nginx con certificado)
DJANGO_HTTPS=False

# --- Correo (Gmail: usar una "contraseña de aplicación") ---
